# Public origin used for metadata, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=https://projectsautodetailing.com

# Google Analytics 4 measurement ID (e.g. G-ABC123XYZ). Leave blank to disable analytics entirely.
# Must be set at build time: it also opens the Content-Security-Policy for Google's domains.
NEXT_PUBLIC_GA_ID=

# Transactional email (booking + contact). Leave blank in dev: submissions are logged to the console instead.
# With RESEND_API_KEY set, BOOKING_NOTIFY_EMAIL is required: siteConfig.email is null (no public inbox).
RESEND_API_KEY=
BOOKING_NOTIFY_EMAIL=bookings@projectsautodetailing.com
BOOKING_FROM_EMAIL="Project's Auto Detailing <bookings@projectsautodetailing.com>"

# --- Static export (GitHub Pages) ---------------------------------------------
# STATIC_EXPORT=true builds plain HTML into ./out (no server: forms use the options below).
STATIC_EXPORT=
# Sub-path when hosted at https://<user>.github.io/<repo>/ (leave empty for a custom domain).
NEXT_PUBLIC_BASE_PATH=
# Optional Formspree-style JSON endpoint for booking and contact forms on static hosting.
# Without it, submitting a form opens the visitor's messaging app with a text to the shop's
# phone number pre-filled (the business has no email inbox; see siteConfig.email).
NEXT_PUBLIC_FORM_ENDPOINT=
